    "Rescan" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "重新扫描" }
        }
      }
    },
    "SandboxArk can preview text, JSON, and plist files only." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "SandboxArk 只能预览文本、JSON 和 plist 文件。" }
        }
      }
    },
    "SandboxArk can read every file this app can access, so a backup can contain private app data. The archive is built and kept in this app's temporary storage until you export it, and SandboxArk never uploads anything." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "SandboxArk 可以读取此 App 能访问的所有文件，因此备份可能包含 App 的私有数据。归档在导出前只存在于本 App 的临时存储中，SandboxArk 从不上传任何内容。" }
        }
      }
    },
    "SandboxArk could not open this app's home directory, so no archive was created." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "SandboxArk 无法打开此 App 的主目录，因此没有创建归档。" }
        }
      }
    },
    "SandboxArk could not open this app's home directory, so nothing was read." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "SandboxArk 无法打开此 App 的主目录，因此没有读取任何内容。" }
        }
      }
    },
    "SandboxArk could not read part of the sandbox, so the backup stopped." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "SandboxArk 无法读取沙盒的一部分，备份已停止。" }
        }
      }
    },
    "SandboxArk could not save the archive to this device's storage." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "SandboxArk 无法把归档写入此设备的存储。" }
        }
      }
    },
    "SandboxArk may access all files that this app itself can access. Backups can contain private app data and are exported only when you ask." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "SandboxArk 可以访问此 App 自身能访问的所有文件。备份可能包含 App 的私有数据，只会在你主动导出时导出。" }
        }
      }
    },
    "SandboxArk's Own Files" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "SandboxArk 自身的文件" }
