        }
      }
    },
    "No archive was created, and this transaction's temporary files were removed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "没有创建归档，本次事务的临时文件已删除。" }
