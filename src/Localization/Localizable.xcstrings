      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "临时文件" }
        }
      }
    },
    "The archive could not be prepared for restoring." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "无法准备要恢复的归档。" }
        }
      }
    },
    "The archive could not be written, so the backup stopped." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "无法写入归档，备份已停止。" }
        }
      }
    },
    "The archive did not match its checksums, so it was not kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "归档与校验和不符，因此没有保留。" }
        }
      }
    },
    "The archive was not exported. It still sits in SandboxArk's temporary storage and can be exported again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "归档没有导出，它仍在 SandboxArk 的临时存储中，可以再次导出。" }
        }
      }
    },
    "The archive was not made for this app." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "这个归档不是为此 App 创建的。" }
        }
      }
    },
    "The archive will be marked partial, and every folder that could not be read completely is listed inside it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "归档会被标记为部分备份，每个未能完整读取的文件夹都会列在里面。" }
        }
      }
    },
    "The archive's index could not be read back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "无法回读归档的索引。" }
        }
      }
    },
    "The backup was cancelled before it finished." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "备份在完成前被取消。" }
        }
      }
    },
    "The file could not be read." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "无法读取该文件。" }
        }
      }
    },
    "The listing stopped at the depth limit." : {
      "localizations" : {
        "zh-Hans" : {
