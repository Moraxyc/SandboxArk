        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "达到深度上限而停止" }
        }
      }
    },
    "Stopped at the Entry Limit" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "达到条目上限而停止" }
        }
      }
