    "The scan is complete. You can start the backup." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "扫描完成，可以开始备份。" }
        }
      }
    },
    "Export and keep a copy of your backup. The copy in this app is temporary: the system may remove it, and your next backup replaces it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "请导出并保留备份副本。App 内的副本仅临时保存，系统可能将其清除，下次备份也会将其替换。" }
        }
      }
    },
    "Cancel This Task?" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "取消当前任务？" }
        }
      }
    },
    "Cancelling stops the current task and removes its temporary files. Wait for cleanup to finish before closing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "取消会停止当前任务并删除其临时文件。请等待清理完成后再关闭。" }
        }
      }
    },
    "Keep Working" : {
      "localizations" : {
