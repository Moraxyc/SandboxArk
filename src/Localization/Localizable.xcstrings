    "Cancel stops the backup and removes this transaction's temporary files. Only a fully verified archive can be exported." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "取消会停止备份并删除本次事务的临时文件。只有完整校验通过的归档才能导出。" }
