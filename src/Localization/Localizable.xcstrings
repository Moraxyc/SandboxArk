          "stringUnit" : { "state" : "translated", "value" : "列表达到条目上限而停止。" }
        }
      }
    },
    "The listing stopped before it finished." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "列表在完成前停止了。" }
        }
      }
    },
    "The scan only reads; stopping it leaves the sandbox unchanged." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "扫描只读取，停止扫描不会改动沙盒。" }
        }
      }
    },
    "The scan stopped at the depth limit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "扫描达到深度上限而停止。" }
        }
      }
    },
    "The scan stopped at the entry limit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "扫描达到条目上限而停止。" }
        }
      }
    },
    "The scan stopped before it finished." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "扫描在完成前停止了。" }
        }
      }
    },
    "The verified archive was kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "已校验的归档已保留。" }
